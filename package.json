{
  "name": "@tanulmittal/wifi-cli",
  "version": "0.1.0",
  "description": "Friendly cross-platform WiFi manager for Ubuntu/Linux/macOS — scan, connect, edit, forget, doctor via one 'openwifi' command.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "openwifi": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "keywords": [
    "wifi",
    "openwifi",
    "nmcli",
    "networksetup",
    "cli",
    "ubuntu",
    "macos",
    "bun"
  ],
  "homepage": "https://github.com/tanulmittal/wifi-cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanulmittal/wifi-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/tanulmittal/wifi-cli/issues"
}
