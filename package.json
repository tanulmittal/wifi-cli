{
  "name": "wifi-cli",
  "version": "0.2.0-beta.5",
  "description": "Friendly cross-platform WiFi manager for Ubuntu/Linux/macOS — scan, connect, edit, forget, doctor via one 'openwifi' command.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "openwifi": "./dist/openwifi.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bundle": "tsc && esbuild src/cli.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/openwifi.cjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@clack/prompts": "^0.8.1",
    "@types/node": "^22.7.0",
    "commander": "^12.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "keywords": [
    "wifi",
    "openwifi",
    "nmcli",
    "networksetup",
    "cli",
    "ubuntu",
    "macos",
    "bun"
  ],
  "homepage": "https://github.com/tanulmittal/wifi-cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanulmittal/wifi-cli.git"
  },
  "bugs": "https://github.com/tanulmittal/wifi-cli/issues"
}
